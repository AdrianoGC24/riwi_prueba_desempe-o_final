# DATAMART By Adriano Gonzalez - CONFIGURACIÓN DE ENTORNO (Airflow 3.1.5 + PostgreSQL 16)

AIRFLOW_IMAGE_NAME=apache/airflow:3.1.5
AIRFLOW_UID=50000

# Rutas de Volúmenes en el Host
DAGS_DIR=./dags
LOGS_DIR=./logs
DATA_SOURCES_DIR=./data_sources
SQL_VALIDATIONS_DIR=./sql_validations
DATABASE_INIT_DIR=./database_init

# Seguridad Criptográfica y Autenticación de Airflow
AIRFLOW_FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLbfzqDDho=
AIRFLOW_JWT_SECRET=datamart_super_secret_shared_jwt_key_2026

# Usuario Administrador de Airflow UI (http://localhost:8080)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Base de Datos 1: Metadatos Internos de Airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

# Base de Datos 2: Repositorio Analítico / Data Warehouse (Separado)
DW_HOST=warehouse-postgres
DW_PORT=5432
DW_USER=dw_admin
DW_PASSWORD=dw_secure_password_2026
DW_DB=datamart_dw
DW_EXTERNAL_PORT=5433

# Crea automáticamente la Airflow Connection con conn_id = 'postgres_dw'
AIRFLOW_CONN_POSTGRES_DW=postgresql://dw_admin:dw_secure_password_2026@warehouse-postgres:5432/datamart_dw

# Crea automáticamente la Airflow Connection con conn_id = 'catalog_api'
AIRFLOW_CONN_CATALOG_API=http://fastapi-catalog:8000

# Crea automáticamente las Airflow Variables operativas del pipeline
AIRFLOW_VAR_DATA_SOURCES_DIR=/opt/airflow/data_sources
AIRFLOW_VAR_STAGING_DIR=/opt/airflow/logs/staging
AIRFLOW_VAR_BATCH_SIZE=50000
AIRFLOW_VAR_USE_CATALOG_API=true
